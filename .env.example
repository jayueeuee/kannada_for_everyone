# =====================================================================
# Kannada for Everyone — Environment Configuration Template
# Copy this file to .env and configure your local credentials
# =====================================================================

# Application Secret Key
APP_SECRET_KEY=replace_with_a_long_random_secret_string_for_production

# MySQL 8+ Database Connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=kannada_everyone

# Hugging Face Inference Providers (create a fine-grained token with Inference Providers access)
MODEL_PROVIDER=huggingface
USE_HUGGINGFACE=true
HF_TOKEN=hf_replace_with_your_token
HF_CHAT_COMPLETIONS_URL=https://router.huggingface.co/v1/chat/completions
HF_ASR_BASE_URL=https://router.huggingface.co/hf-inference/models
HF_TEXT_MODEL=openai/gpt-oss-20b
HF_WHISPER_MODEL=openai/whisper-large-v3

INFERENCE_TIMEOUT_SECONDS=180

# Limits and Timeouts
DEFAULT_TIMEZONE=Asia/Kolkata
AI_MAX_REQUESTS_PER_DAY=50
